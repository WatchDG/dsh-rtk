{
  "name": "dsh-rtk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RTK (Rust Token Killer) integration for DeepSeek Harness: prompt rules and a pre-execution hook for token-optimized terminal output.",
  "license": "Apache-2.0",
  "author": "Baranov Grigoriy Vladimirovich",
  "homepage": "https://github.com/WatchDG/dsh-rtk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WatchDG/dsh-rtk.git"
  },
  "bugs": {
    "url": "https://github.com/WatchDG/dsh-rtk/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "rtk",
    "token-saving",
    "cli",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "README.ru.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node --test",
    "test:unit": "node --test test/command.test.mjs test/plugin.test.mjs test/manifest.test.mjs",
    "test:integration": "node --test test/integration.test.mjs",
    "pack:check": "npm pack --dry-run"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
